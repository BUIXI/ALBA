<?xml version="1.0" encoding="utf-8"?>
<!-- Icono de Alba: el sol asomando sobre el mar. Lienzo de 108 dp; lo que importa
     cabe en el círculo central de 66 dp (el resto lo puede recortar la máscara del
     lanzador). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Medio sol -->
    <path
        android:fillColor="#FF9F0A"
        android:pathData="M35,60 A19,19 0 0,1 73,60 Z" />
    <!-- Horizonte: ancho, para que se lea como horizonte y no como un ala -->
    <path
        android:pathData="M24,65.5H84"
        android:strokeWidth="3.2"
        android:strokeColor="#FF9F0A"
        android:strokeLineCap="round" />
    <!-- Reflejos en el agua, cada vez más cortos y tenues -->
    <path
        android:pathData="M40,72.5H68"
        android:strokeWidth="3.2"
        android:strokeAlpha="0.45"
        android:strokeColor="#FF9F0A"
        android:strokeLineCap="round" />
    <path
        android:pathData="M48,79.5H60"
        android:strokeWidth="3.2"
        android:strokeAlpha="0.22"
        android:strokeColor="#FF9F0A"
        android:strokeLineCap="round" />
</vector>
